# EditorConfig is awesome: https://editorconfig.org
# Property reference: https://spec.editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab
